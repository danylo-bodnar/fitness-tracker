{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Authentication": {
      "MaxRequests": 5,
      "WindowSeconds": 60
    },
    "Api": {
      "MaxTokens": 15,
      "RefillRate": 1
    }
  },
  "Telegram": {
    "BotUsername": "liftlogbot"
  }
}

[
  {
    "label": "Debug AppHost (Aspire)",
    "adapter": "coreclr",
    "request": "launch",
    "program": "dotnet",
    "args": [
      "run",
      "--project",
      "src/backend/FitnessTracker.AppHost/FitnessTracker.AppHost.csproj",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "ASPNETCORE_ENVIRONMENT": "Development",
      "DOTNET_ENVIRONMENT": "Development",
    },
  },
  {
    "label": "Debug API",
    "adapter": "coreclr",
    "request": "launch",
    "program": "dotnet",
    "args": [
      "run",
      "--project",
      "src/backend/FitnessTracker.Api/FitnessTracker.Api.csproj",
      "--launch-profile",
      "https",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "ASPNETCORE_ENVIRONMENT": "Development",
      "DOTNET_ENVIRONMENT": "Development",
    },
  },
  {
    "label": "Attach",
    "adapter": "coreclr",
    "request": "attach",
  },
]
